# .env - переменные окружения проекта (пример).
#
# Скопируйте в .env (docker compose читает его из корня автоматически):
#   cp .env.example .env
#
# .env НЕ коммитится (см. .gitignore). Значения ниже - рабочие дефолты
# docker-compose.yml для локальной разработки и демо; реальных секретов
# в репозитории нет. Для общего окружения смените пароль.

# --- База данных (db + backend + seed) --------------------------------------
POSTGRES_DB=robomatch
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Разработка БЕЗ Docker (по желанию, вручную) ----------------------------
# Backend (application.yml): DB_URL / DB_USERNAME / DB_PASSWORD.
# BFF-роут frontend (app/api/solutions/route.ts): BACKEND_URL.
# Свой адрес Next.js (lib/api.ts) обычно определяется сам (APP_URL).
# DB_URL=jdbc:postgresql://localhost:5432/robomatch
# DB_USERNAME=postgres
# DB_PASSWORD=postgres
# BACKEND_URL=http://localhost:8080
# APP_URL=http://localhost:3000

# --- Аутентификация ---------------------------------------------------------
# Секрет JWT обязателен для docker compose (backend падает без него).
# Сгенерируйте свой:  openssl rand -base64 48
JWT_SECRET=change-me-generate-with-openssl-rand-base64-48-min-32-bytes
# Срок жизни токена, часы (по умолчанию 24)
# JWT_TTL_HOURS=24
# Cookie сессии BFF: true только если демо работает по https
COOKIE_SECURE=false
# Срок cookie сессии, секунды (по умолчанию 86400 = 24 ч)
# SESSION_TTL_SECONDS=86400

# --- Загрузка файлов ---------------------------------------------------------
# Лимит вложений, байт (по умолчанию 10485760 = 10 МБ): точную проверку
# делает сервисный слой; servlet-потолок отдельно (см. ниже).
# UPLOAD_MAX_BYTES=10485760

# --- Импорт таблицы каталога -------------------------------------------------
# Лимит таблицы каталога, байт (по умолчанию 52428800 = 50 МБ).
# ADMIN_IMPORT_MAX_BYTES=52428800
# Корень хранилища копий таблиц (для «обновить по запросу»).
# В docker-compose переопределяется на /app/data/admin-imports.
# ADMIN_IMPORT_ROOT=./data/admin-imports

# --- Servlet multipart (грубый первый гейт загрузок) --------------------------
# Верхняя граница любого multipart-файла (по умолчанию 50 МБ - таблица
# каталога); точные лимиты по назначению - сервисные (см. выше).
# SERVLET_MAX_FILE_SIZE=50MB

# --- Seed вручную (в docker-compose запускается сам) -------------------------
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/robomatch
